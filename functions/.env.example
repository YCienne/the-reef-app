# Google Generative AI key used by the chat/AI-explanation feature (routes/chatRoutes.js).
# Without this the feature falls back to a placeholder key and won't work.
GEMINI_API_KEY=

# Paystack secret key for payment processing (controllers/paystackController.js)
PAYSTACK_SECRET_KEY=

# Frontend origin used to build post-payment redirect URLs (controllers/paystackController.js)
FRONTEND_URL=

# Invite code compared against signup's inviteCode to grant the admin role (routes/userRoutes.js)
ADMIN_SECRET=

# Optional: storage bucket fallback used only when FIREBASE_CONFIG is not set (index.js).
# Set this to your actual Firebase project's bucket for local dev.
STORAGE_BUCKET=

# Optional: port for the local dev server (dev.js). Defaults to 5000.
LOCAL_BACKEND_PORT=

# Not read directly by this code, but required for firebase-admin to authenticate
# against a real Firebase project when running locally:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
